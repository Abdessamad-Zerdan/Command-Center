# IANA timezone name — drives the brief's "today" boundary, the clock in
# the header, and the scheduler. Defaults to UTC if unset.
APP_TIMEZONE=UTC

# auto | ollama | groq | anthropic — see SETUP.md step 3 for how to configure each
#   auto:   checks whether llama3.2:3b (or OLLAMA_MODEL below, if set) is
#           pulled in a local Ollama install; uses it if so, otherwise falls
#           back to Groq. Also falls back automatically if Ollama fails
#           mid-request. Needs GROQ_API_KEY set below for the fallback to
#           actually work once it's needed.
TRIAGE_PROVIDER=auto

# Model name format depends on TRIAGE_PROVIDER — these aren't interchangeable:
#   ollama: an `ollama pull`-ed tag, e.g. llama3.2:3b
#   groq:   a Groq-hosted model id, e.g. openai/gpt-oss-120b
# Used by TRIAGE_PROVIDER=groq/ollama/anthropic directly, and by auto's Groq
# fallback leg specifically (auto's Ollama leg checks for llama3.2:3b, or
# OLLAMA_MODEL below if set — not this one).
TRIAGE_MODEL=llama3.2:3b

# Only used by TRIAGE_PROVIDER=auto's local leg, to pin a specific model
# instead of the default llama3.2:3b — e.g. if you've already pulled a
# different one and don't want to also pull llama3.2:3b just for this.
OLLAMA_MODEL=

# Only required when TRIAGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Required for TRIAGE_PROVIDER=groq, and for auto's fallback once it's needed
GROQ_API_KEY=
# Optional — additional Groq accounts' keys, tried in order whenever the
# one before it is rate-limited, invalid, or otherwise failing.
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_BACKUP_2=

# Medium personal feed (RapidAPI medium2.p.rapidapi.com) — optional, the
# Reading lane just stays empty (degraded, logged) if unset.
MEDIUM_API_KEY=
MEDIUM_USERNAME=
