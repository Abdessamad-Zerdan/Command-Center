# IANA timezone name — drives the brief's "today" boundary, the clock in
# the header, and the scheduler. Defaults to UTC if unset.
APP_TIMEZONE=UTC

# ollama | groq | anthropic — see SETUP.md step 3 for how to configure each
TRIAGE_PROVIDER=ollama

# Model name format depends on TRIAGE_PROVIDER — these aren't interchangeable:
#   ollama: an `ollama pull`-ed tag, e.g. llama3.2:3b
#   groq:   a Groq-hosted model id, e.g. llama-3.3-70b-versatile
TRIAGE_MODEL=llama3.2:3b

# Only required when TRIAGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only required when TRIAGE_PROVIDER=groq
GROQ_API_KEY=
# Optional — additional Groq accounts' keys, tried in order whenever the
# one before it is rate-limited, invalid, or otherwise failing.
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_BACKUP_2=

# Medium personal feed (RapidAPI medium2.p.rapidapi.com) — optional, the
# Reading lane just stays empty (degraded, logged) if unset.
MEDIUM_API_KEY=
MEDIUM_USERNAME=
